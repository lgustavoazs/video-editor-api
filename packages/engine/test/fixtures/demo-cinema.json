{
  "id": "demo-cinema",
  "version": 1,
  "name": "Demonstração: cinema",
  "extends": "limpo",
  "description": "Visual de cinema feito só com efeitos do catálogo: LUT, contraste, vinheta, grão e barras.",
  "photo": {
    "fit": "auto",
    "filters": [
      {
        "type": "lut",
        "file": "cinema-azul-laranja.cube"
      },
      {
        "type": "color",
        "contrast": 1.08,
        "saturation": 0.95
      },
      {
        "type": "vignette",
        "strength": 0.35
      },
      {
        "type": "grain",
        "amount": 9
      }
    ]
  },
  "motion": {
    "type": "kenburns",
    "zoomFrom": 1.0,
    "zoomTo": 1.12,
    "direction": "alternate"
  },
  "transition": {
    "types": [
      "fade",
      "fadeblack"
    ],
    "order": "cycle",
    "duration": 0.7
  },
  "letterbox": 0.07,
  "text": {
    "title": {
      "position": "bottom",
      "size": 0.042,
      "start": 2.6,
      "duration": 3.5
    }
  },
  "branding": {
    "watermark": {
      "role": "brand",
      "position": "top-right",
      "width": 0.17,
      "opacity": 0.92
    },
    "intro": {
      "role": "brand",
      "duration": 2.0,
      "background": "#000000",
      "width": 0.5
    },
    "outro": {
      "role": "brand",
      "duration": 2.2,
      "background": "#000000",
      "width": 0.55,
      "caption": "Fusegi Canoas Judô"
    }
  }
}
