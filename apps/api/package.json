{
  "name": "@video-editor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=1 test/*.test.ts",
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@video-editor/engine": "*",
    "ajv": "^8.20.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
